#!/usr/bin/expect -f
#
# RAVLIN install test — drives the REAL interactive void-installer.
#
# Boots the live ISO through its own bootloader onto a machine with one
# blank virtio disk, logs in on the serial console, then walks the actual
# dialog-based installer menus with the Local source — the documented
# RAVLIN installation — and lets it install to the disk. This is the
# installation users perform, not a parallel network autoinstaller.
#
# dialog navigation notes (verified against a full CI run):
#   - the serial terminal runs in application-keypad mode, so CSI arrow
#     sequences (ESC [ B) are ignored by dialog; menu items are selected
#     with the number keys 1-9 or the first letter of the tag (both per
#     dialog(1))
#   - the Filesystems loop is left with ESC: dialog reports cancel
#     (exit status >= 1), which menu_filesystems treats as its Done
#     button, returning to the main menu with the settings kept
#
# Every wait goes through await: a screen that does not appear fails the
# step within the current timeout instead of wedging the job until its
# timeout, and the message names the screen that was expected.

set timeout 1800
log_file -noappend install-serial.log

spawn qemu-system-x86_64 -m 3584 -smp 2 -nographic -no-reboot \
    -nic user,model=virtio-net-pci \
    -drive file=disk.img,format=raw,if=virtio \
    -cdrom [glob ravlin-live-*.iso] -boot d

proc await {pattern} {
    expect {
        $pattern { puts "\n=== ok: $pattern ===" }
        timeout { puts "\n=== FAILED: timeout waiting for: $pattern ==="; exit 1 }
        eof     { puts "\n=== FAILED: guest exited while waiting for: $pattern ==="; exit 1 }
    }
}

expect {
    "login:" { puts "\n=== live ISO booted through its bootloader ===" }
    timeout  { puts "\n=== FAILED: live boot timeout ==="; exit 1 }
    eof      { puts "\n=== FAILED: qemu exited ==="; exit 1 }
}

set timeout 120
send "root\r"
await "Password:"
send "voidlinux\r"
await "minimal Void Linux remix"

# Partition the target disk up front so the installer's interactive
# Partition step (cfdisk/fdisk) can be skipped; its Filesystems step then
# sees /dev/vda1. Partitioning itself is upstream tooling, not RAVLIN
# code, and the installer does not require the Partition menu to have
# been used.
#
# The success marker is assembled from split tokens (string join) so it
# never appears contiguously in the terminal echo of the typed command.
set timeout 300
send "printf 'label: dos\\ntype=83\\n' | sfdisk /dev/vda; and string join '' RAVLIN_ PARTITIONED _OK\r"
await "RAVLIN_PARTITIONED_OK"
set timeout 120

# --- void-installer: the documented interactive install -----------------
send "void-installer\r"
await "Enter the void"
send "\r"                     ;# welcome msgbox

# Root password (entered twice)
await "installation menu"
send "R\r"
await "Enter the root password"
send "ravlin-ci\r"
await "Enter the root password again"
send "ravlin-ci\r"

# Bootloader: /dev/vda is the first (and only) disk entry; graphical
# terminal for GRUB: yes
await "installation menu"
send "B\r"
await "Select the disk to install the bootloader"
send "\r"
await "Use a graphical terminal for the boot loader?"
send "\r"

# Filesystems: /dev/vda1 as ext4, mounted on /, newly created
await "installation menu"
send "F\r"
await "Select the partition to edit"
send "\r"                     ;# /dev/vda1 is the only entry (Change)
await "Select the filesystem type for /dev/vda1"
send "4\r"                    ;# ext4: menu items are btrfs ext2 ext3 ext4...
await "Please specify the mount point for /dev/vda1:"
send "/\r"
await "Do you want to create a new filesystem on /dev/vda1?"
send "\r"                     ;# yes
await "Select the partition to edit"
send "\033"                   ;# ESC = Done; back to the main menu, settings kept

# Source: Local — copies the live rootfs; this is the RAVLIN install
await "installation menu"
send "S\r"
await "Select installation source"
send "\r"                     ;# Local

# Install: mkfs, rootfs copy, dracut, GRUB — slow under TCG
await "installation menu"
set timeout 3600
send "I\r"
await "The user account is not set up properly"
send "\r"                     ;# continue without a user
await "The following operations will be executed"
await "Do you want to continue?"
send "\r"
await "Select services to enable"
send "\t\r"                   ;# TAB to OK, accept the current set
await "has been installed successfully"
await "Do you want to reboot the system?"
send "\r"                     ;# yes; QEMU exits because of -no-reboot

set timeout 300
expect {
    eof     { puts "\n=== INSTALL PASSED: installer completed, guest rebooted ===" }
    timeout { puts "\n=== INSTALL FAILED: guest did not reboot ==="; exit 1 }
}
